{
  "openapi": "3.0.1",
  "info": {
    "title": "INU Portal API",
    "version": "v1.0"
  },
  "paths": {
    "/api/cafeterias": {
      "get": {
        "tags": ["Cafeterias"],
        "summary": "학식 메뉴 가져오기",
        "description": "식당 이름과 요일(1~7)을 보내주세요. [조식, 중식, 석식] 순으로 반환됩니다.",
        "operationId": "getCafeteriaMenu",
        "parameters": [
          {
            "name": "cafeteria",
            "in": "query",
            "description": "식당 이름 (학생식당, 제1기숙사식당, 2기숙사 식당, 27호관식당, 사범대식당)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "day",
            "in": "query",
            "description": "요일 (1: 월 ~ 7: 일)",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공"
          }
        }
      }
    },
    "/api/buses/arrivals": {
      "get": {
        "tags": ["Buses"],
        "summary": "실시간 버스 도착 정보 조회",
        "description": "정류소 ID 기반 인천시 실시간 시내버스 도착 정보를 제공합니다.",
        "operationId": "getBusArrivals",
        "parameters": [
          {
            "name": "bstopId",
            "in": "query",
            "description": "정류소 ID (예: 165000384)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공"
          }
        }
      }
    },
    "/api/timetables/today": {
      "get": {
        "tags": ["TimeTables"],
        "summary": "오늘의 내 시간표 조회",
        "description": "로그인한 학생의 당일 강의 시간표 및 강의실 정보를 조회합니다.",
        "operationId": "getTodayTimeTable",
        "security": [
          { "bearerAuth": [] }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "조회 성공"
          }
        }
      }
    },
    "/api/notices": {
      "get": {
        "tags": ["Notices"],
        "summary": "캠퍼스 공지사항 목록 조회",
        "description": "학사, 장학, 채용 등 카테고리별 최신 학교 공지사항을 조회합니다.",
        "operationId": "getNotices",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "description": "공지 카테고리 (학사, 장학, 일반, 행사)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공"
          }
        }
      }
    },
    "/api/directory/search": {
      "get": {
        "tags": ["Directory"],
        "summary": "교내 전화번호부 및 연락처 검색",
        "description": "교수, 학과 사무실(과사), 교직원, 부서의 전화번호, 이메일, 연구실/사무실 위치를 검색합니다.",
        "operationId": "searchContacts",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "description": "검색어 (교수명, 학과명, 부서명, 과사 등)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공"
          }
        }
      }
    },
    "/api/weather": {
      "get": {
        "tags": ["Weather"],
        "summary": "송도 캠퍼스 실시간 날씨 및 미세먼지 조회",
        "description": "인천대학교 송도 캠퍼스의 실시간 기온, 하늘 상태, 강수, 미세먼지(PM10) 등급을 조회합니다.",
        "operationId": "getWeather",
        "parameters": [],
        "responses": {
          "200": {
            "description": "조회 성공"
          }
        }
      }
    },
    "/api/calendar": {
      "get": {
        "tags": ["Schedule"],
        "summary": "학사일정 캘린더 조회",
        "description": "연도와 월별 주요 학사일정 및 학과 일정을 조회합니다.",
        "operationId": "getAcademicCalendar",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "description": "연도 (예: 2026)",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "month",
            "in": "query",
            "description": "월 (1~12)",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공"
          }
        }
      }
    },
    "/api/timetables/gap": {
      "get": {
        "tags": ["TimeTables"],
        "summary": "오늘의 공강 시간 계산",
        "description": "오늘 강의 시간표 사이의 공강 시간과 빈 강의실/휴식 공간을 계산하여 안내합니다.",
        "operationId": "getTimetableGap",
        "security": [
          { "bearerAuth": [] }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "조회 성공"
          }
        }
      }
    }
  }
}
