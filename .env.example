# ==============================================================================
# inu-agent-core Environment Variables Template
#
# NOTE: DO NOT COMMIT REAL CREDENTIALS OR HOSTS TO VERSION CONTROL.
# Copy this file to .env and configure with your actual environment values.
# ==============================================================================

# Application Configuration
APP_NAME=inu-agent-core
APP_ENV=development
APP_PORT=8000
DEBUG=true

# GPU / LLM Inference Cluster (LiteLLM / vLLM - OpenAI-Compatible Endpoint)
# Example: https://gpu.example.inu.ac.kr/v1
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=your_litellm_api_key_here
LLM_MODEL_NAME=gemma-27b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60

# Redis Cache & Session Context
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Internal Service URLs
# Base URL for inu-portal-server
INU_PORTAL_SERVER_URL=http://localhost:8080
# Optional S2S Shared Secret for internal delegation
INU_INTERNAL_S2S_SECRET=your_s2s_shared_secret_here

# Security & CORS
# Allowed origins comma-separated (e.g., https://intip.inu.ac.kr,http://localhost:3000)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
